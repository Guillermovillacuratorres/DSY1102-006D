<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ejerciciotipoprueba.controller.PersonaController">
   <children>
      <Label layoutX="14.0" layoutY="88.0" text="Edad:" />
      <Label layoutX="5.0" layoutY="117.0" text="Nombre:" />
      <Label layoutY="229.0" text="Titulo:" />
      <CheckBox fx:id="chbCasado" layoutX="59.0" layoutY="177.0" mnemonicParsing="false" text="Casado" />
      <ComboBox fx:id="cmbTipo" layoutX="59.0" layoutY="41.0" onAction="#cambiarTipo" prefWidth="150.0" />
      <Label layoutX="16.0" layoutY="45.0" text="Tipo" />
      <TextField fx:id="txtEdad" layoutX="60.0" layoutY="84.0" />
      <TextField fx:id="txtNombre" layoutX="60.0" layoutY="122.0" />
      <TextField fx:id="txtTitulo" layoutX="45.0" layoutY="225.0" />
      <TextField fx:id="txtSueldo" layoutX="45.0" layoutY="275.0" />
      <TextField fx:id="txtNivel" layoutX="45.0" layoutY="317.0" />
      <Label layoutY="279.0" text="Sueldo:" />
      <Label layoutY="321.0" text="Nivel:" />
      <Button layoutX="109.0" layoutY="355.0" mnemonicParsing="false" onAction="#agregar" text="Agregar" />
      <Button layoutX="525.0" layoutY="323.0" mnemonicParsing="false" onAction="#eliminar" text="Eliminar" />
      <TableView fx:id="tblPersonas" layoutX="216.0" layoutY="29.0" prefHeight="267.0" prefWidth="379.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="73.0" text="ID" />
          <TableColumn fx:id="colNombre" prefWidth="77.0" text="NOMBRE" />
            <TableColumn fx:id="colCasado" prefWidth="75.0" text="Casado" />
            <TableColumn fx:id="colEdad" prefWidth="75.0" text="Edad" />
            <TableColumn fx:id="colCalculo" prefWidth="75.0" text="Calculo" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
